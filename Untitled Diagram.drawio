<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/112.0.0.0 Safari/537.36" version="29.1.1">
  <diagram name="Page-1" id="2YBvvXClWsGukQMizWep">
    <mxGraphModel dx="2206" dy="3012" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\nactor User\nparticipant \&quot;get_digital_io(srv)\&quot; as GetIOService\nparticipant \&quot;set_digital_io_state(srv)\&quot; as SetIOService\nparticipant \&quot;digital_io_state(Topic)\&quot; as DigitalIOTopic\nparticipant NiryoOneDriver as Driver\nparticipant NiryoOneCommunication as Comm\nparticipant EthercatCommunication as EC\nparticipant DS402Driver as DS402\n\n&#39;-------------------------------------------\n&#39; EtherCAT Initialization\n&#39;-------------------------------------------\nEC -&gt; EC : EthercatCommunication() (constructor)\nEC -&gt; EC : initPinMap()\nnote right of EC : creates pin_map for all DI/DO pins\\nand assigns slave IDs\n\n&#39;-------------------------------------------\n&#39; Example: Get Digital IO\n&#39;-------------------------------------------\nUser -&gt; GetIOService : call GetDigitalIO(pin)\nGetIOService -&gt; Driver : callbackGetIO(pin)\nDriver -&gt; Comm : getDigitalIO(pin)\nComm -&gt; EC : getDigitalIO(pin)\nEC -&gt; EC : check pin_map\nalt pin is input\n    EC -&gt; EC : getDigitalInput(pin, value)\n    EC -&gt; DS402 : readProcessData()\n    DS402 --&gt; EC : return DI mask\n    EC --&gt; EC : extract bit value from mask\nelse pin is output\n    EC -&gt; EC : getDigitalOutput(pin, value)\n    EC -&gt; DS402 : readProcessData()\n    DS402 --&gt; EC : return DO mask\n    EC --&gt; EC : extract bit value from mask\nend\nEC --&gt; Comm : return value\nComm --&gt; Driver : return value\nDriver --&gt; GetIOService : return response\n\n&#39;-------------------------------------------\n&#39; Example: Set Digital IO\n&#39;-------------------------------------------\nUser -&gt; SetIOService : call SetDigitalIOState(pin, value)\nSetIOService -&gt; Driver : callbackSetIOState(pin, value)\nDriver -&gt; Comm : setDigitalIO(pin, value)\nComm -&gt; EC : setDigitalOutput(pin, value)\nEC -&gt; EC : check pin_map\nEC -&gt; DS402 : readProcessData() (current DO mask)\nEC -&gt; EC : update bit in DO mask\nEC -&gt; DS402 : writeProcessData() (new DO mask)\nDS402 --&gt; EC : return status\nEC --&gt; Comm : return status\nComm --&gt; Driver : return status\nDriver --&gt; SetIOService : return response\n\n&#39;-------------------------------------------\n&#39; Example: Publish Digital IO State\n&#39;-------------------------------------------\nDriver -&gt; Comm : getDigitalIO(pin, value) [for all pins]\nComm -&gt; EC : getDigitalIO(pin)\nEC -&gt; EC : check pin_map\nalt pin is input\n    EC -&gt; EC : getDigitalInput(pin, value)\n    EC -&gt; DS402 : readProcessData()\n    DS402 --&gt; EC : DI mask\n    EC --&gt; EC : extract bit\nelse pin is output\n    EC -&gt; EC : getDigitalOutput(pin, value)\n    EC -&gt; DS402 : readProcessData()\n    DS402 --&gt; EC : DO mask\n    EC --&gt; EC : extract bit\nend\nEC --&gt; Comm : return value\nComm --&gt; Driver : return value\nDriver -&gt; DigitalIOTopic : publish DigitalIOState message\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="qcFkNh3lF0UGicv6IjEd-1">
          <mxCell parent="1" style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1">
            <mxGeometry height="1724" width="1578" x="-671" y="-1479" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
